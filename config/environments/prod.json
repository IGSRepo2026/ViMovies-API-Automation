{
  "description": "Values from the VIMTV Postman collection. {{...}} placeholders mean 'not set' - provide them via .env.",
  "variables": {
    "apiBaseUrl": "https://apiplay.vodafoneplay.in",
    "searchBaseUrl": "https://apisearch.vodafoneplay.in",
    "webBaseUrl": "https://moviesandtv.myvi.in",
    "packageBaseUrl": "https://apiplay.vodafoneplay.in",
    "boxId": "{{SET_TEST_BOX_ID}}",
    "sessionId": "{{SET_SESSION_ID_AFTER_AUTH}}",
    "signoutSessionId": "{{SET_DISPOSABLE_SESSION_FOR_SIGNOUT}}",
    "tenantCode": "vfplay",
    "productCode": "vfplay",
    "mobileNumberWithCountryCode": "{{SET_AUTHORIZED_TEST_MOBILE}}",
    "otpReferenceId": "{{SET_FROM_GET_OTP_RESPONSE}}",
    "otpCode": "{{ENTER_TEST_OTP_AT_RUNTIME}}",
    "testPassword": "{{SET_TEST_PASSWORD_IF_REQUIRED}}",
    "signupReferenceKey": "{{SET_FROM_SIGNUP_VALIDATE_RESPONSE}}",
    "loginKey": "{{SET_LOGIN_KEY_AT_RUNTIME}}",
    "loginId": "{{SET_AUTHORIZED_TEST_LOGIN_ID}}",
    "osVersion": "{{SET_TEST_OS_VERSION}}",
    "appVersion": "{{SET_TEST_APP_VERSION}}",
    "manufacturer": "{{SET_TEST_MANUFACTURER}}",
    "deviceId": "11",
    "deviceSubType": "{{SET_SUPPORTED_CLIENT_SUBTYPE}}",
    "displayLanguageCode": "eng",
    "timezone": "Asia/Kolkata",
    "contentPath": "{{SET_CONTENT_PATH}}",
    "playbackPath": "{{SET_AUTHORIZED_PLAYBACK_PATH}}",
    "parentalPin": "{{SET_TEST_PARENTAL_PIN_IF_REQUIRED}}",
    "pollKey": "{{SET_POLL_KEY_FROM_STREAM_RESPONSE}}",
    "sectionCode": "{{SET_SECTION_CODE}}",
    "tvShowPath": "{{SET_TV_SHOW_PATH}}",
    "deeplinkPath": "{{SET_DEEPLINK_TARGET_PATH}}",
    "sectionPath": "{{SET_SECTION_PATH}}",
    "partnerCode": "{{SET_PARTNER_CODE}}",
    "activationPasscode": "{{ENTER_TEST_PASSCODE_AT_RUNTIME}}",
    "clientType": "android",
    "searchQuery": "love",
    "liveSearchQuery": "news",
    "encryptedSigninData": "{{GENERATE_VALID_ENCRYPTED_SIGNIN_DATA}}",
    "encryptedSigninMetadata": "{{GENERATE_VALID_ENCRYPTED_SIGNIN_METADATA}}",
    "encryptedIdentifier": "{{GENERATE_VALID_ENCRYPTED_IDENTIFIER}}",
    "nextBuildId": "{{UPDATE_FROM_CURRENT_WEB_DEPLOYMENT}}",
    "movieSlug": "{{SET_MOVIE_SLUG}}",
    "deviceToDelinkBoxId": "{{SET_TEST_DEVICE_BOX_ID}}",
    "deviceType": "{{SET_TEST_DEVICE_TYPE}}",
    "packageId": "{{SET_TEST_PACKAGE_ID}}",
    "paymentGateway": "{{APPROVED_TEST_PAYMENT_GATEWAY}}",
    "orderId": "{{ORDER_ID_FROM_TEST_CHECKOUT}}"
  },
  "bodyContract": {
    "statusField": "status",
    "successValues": [true, "SUCCESS", "success", "OK", "ok", 1],
    "failureValues": [false, "FAILURE", "failure", "FAILED", "ERROR", "error", 0],
    "dataField": "response",
    "errorField": "error"
  },
  "sla": {
    "defaultMs": 2000,
    "overrides": {
      "SEARCH_MOVIES": 3000,
      "SEARCH_TV_SHOWS": 3000,
      "SEARCH_TV_SHOW_VIDEOS": 3000,
      "SEARCH_LIVE_CHANNELS": 3000,
      "PACKAGE_CATALOGUE": 3000,
      "STREAM_METADATA": 3000,
      "WEB_HOME_DATA": 3000,
      "WEB_MOVIE_DATA": 3000,
      "WEB_PLANS_DATA": 3000
    }
  },
  "strictHttpErrors": false
}
