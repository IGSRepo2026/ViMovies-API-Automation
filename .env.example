# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every Postman collection variable can be
# overridden here using UPPER_SNAKE_CASE (apiBaseUrl -> API_BASE_URL).
# Values left blank fall back to config/environments/<TEST_ENV>.json.
# Tests whose required data is missing are SKIPPED (not failed).
# ---------------------------------------------------------------------------

# Which config/environments/<name>.json to load (prod | staging | ...)
TEST_ENV=prod

# ---- URLs ------------------------------------------------------------------
API_BASE_URL=
SEARCH_BASE_URL=
WEB_BASE_URL=https://moviesandtv.myvi.in/
PACKAGE_BASE_URL=

# ---- Device / session ------------------------------------------------------
BOX_ID=
SESSION_ID=
# Disposable session used ONLY by the sign-out test (it gets invalidated)
SIGNOUT_SESSION_ID=
TENANT_CODE=
PRODUCT_CODE=
DEVICE_ID=
DEVICE_SUB_TYPE=
OS_VERSION=
APP_VERSION=
MANUFACTURER=
DISPLAY_LANGUAGE_CODE=
TIMEZONE=
CLIENT_TYPE=

# ---- Auth test account (test accounts only!) -------------------------------
MOBILE_NUMBER_WITH_COUNTRY_CODE=
OTP_REFERENCE_ID=
OTP_CODE=
TEST_PASSWORD=
SIGNUP_REFERENCE_KEY=
LOGIN_KEY=
LOGIN_ID=
ENCRYPTED_SIGNIN_DATA=
ENCRYPTED_SIGNIN_METADATA=
ENCRYPTED_IDENTIFIER=

# ---- Content data ----------------------------------------------------------
CONTENT_PATH=
PLAYBACK_PATH=
PARENTAL_PIN=
POLL_KEY=
SECTION_CODE=
TV_SHOW_PATH=
DEEPLINK_PATH=
SECTION_PATH=
PARTNER_CODE=
ACTIVATION_PASSCODE=
SEARCH_QUERY=
LIVE_SEARCH_QUERY=
NEXT_BUILD_ID=
MOVIE_SLUG=

# ---- Devices / payments (sandbox only) -------------------------------------
DEVICE_TO_DELINK_BOX_ID=
DEVICE_TYPE=
PACKAGE_ID=
PAYMENT_GATEWAY=
ORDER_ID=

# ---- Safety switches (default: false) --------------------------------------
# Favourites add/delete, session preference, end stream, sign-out, delink
ALLOW_STATE_CHANGING=false
# OTP dispatch, sign-up, sign-in, checkout (send SMS / create orders)
ALLOW_SENSITIVE=false
# Sends repeated OTP requests to probe throttling (needs ALLOW_SENSITIVE)
RUN_RATE_LIMIT_TESTS=false
# Fetch an anonymous session via get/token before the run if SESSION_ID is empty
# (a QA box id is generated when BOX_ID is empty). The APIs reject calls without one.
AUTO_TOKEN=true

# ---- Behaviour -------------------------------------------------------------
# true  = negative cases must return HTTP 4XX
# false = HTTP 4XX OR HTTP 2XX with a failure body envelope is accepted
STRICT_HTTP_ERRORS=false
DEFAULT_SLA_MS=
PERF_SAMPLES=5
WORKERS=2
REQUEST_TIMEOUT_MS=30000
# Optional endpoint known to return 5XX (e.g. a mock/fault-injection route)
FAULT_INJECTION_URL=
